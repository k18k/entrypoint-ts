{
  "name": "@k18k/entrypoint",
  "version": "0.1.1",
  "description": "SDK Entrypoint: tunel z aplikacji do bramy Entrypoint (kontrakt bazowy i adapter node:http)",
  "homepage": "https://github.com/k18k/entrypoint",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k18k/entrypoint-ts.git"
  },
  "bin": {
    "entrypoint-tunnel": "./lib/cli.js"
  },
  "files": [
    "lib",
    "scripts/postinstall.mjs",
    "connector.json",
    "README.md"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./http": {
      "types": "./lib/http.d.ts",
      "default": "./lib/http.js"
    }
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
